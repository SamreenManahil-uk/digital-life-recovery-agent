# Application
APP_NAME="Digital Life Recovery & Dependency Agent"
APP_ENV=development
DEBUG=true

# Backend
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/digital_life_recovery

# Authentication
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI
AI_API_KEY=your_api_key_here

# Frontend
FRONTEND_URL=http://localhost:5173
